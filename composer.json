{
    "name": "buriti/i-educar-educacenso-import-package",
    "description": "Importação de arquivos do Educacenso/INEP (migração e identificação) para o i-Educar.",
    "version": "1.1.0",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "ieducar",
        "educacenso",
        "inep",
        "importacao",
        "buriti"
    ],
    "authors": [
        {
            "name": "Buriti"
        }
    ],
    "require": {
        "php": ">=8.3",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "iEducar\\Packages\\BuritiEducacensoImport\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "iEducar\\Packages\\BuritiEducacensoImport\\Providers\\BuritiEducacensoImportServiceProvider"
            ]
        },
        "ieducar": {
            "compatible": [
                "2.10",
                "2.11"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
